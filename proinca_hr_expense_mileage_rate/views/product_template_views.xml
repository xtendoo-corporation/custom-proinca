<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_proinca_mileage" model="ir.ui.view">
        <field name="name">product.template.form.proinca.mileage</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="proinca_is_mileage_product"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Tarifas de kilometraje por categoría" invisible="not proinca_is_mileage_product">
                    <field name="proinca_mileage_rate_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="category_id"/>
                            <field name="price_per_km" string="€/km"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active" column_invisible="True"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
