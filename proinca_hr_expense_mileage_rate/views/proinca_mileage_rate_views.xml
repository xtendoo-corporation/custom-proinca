<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_proinca_mileage_rate_tree" model="ir.ui.view">
        <field name="name">proinca.mileage.rate.tree</field>
        <field name="model">proinca.mileage.rate</field>
        <field name="arch" type="xml">
            <list string="Tarifas de kilometraje">
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="price_per_km" string="€/km"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_proinca_mileage_rate_form" model="ir.ui.view">
        <field name="name">proinca.mileage.rate.form</field>
        <field name="model">proinca.mileage.rate</field>
        <field name="arch" type="xml">
            <form string="Tarifa de kilometraje">
                <sheet>
                    <group>
                        <group string="Clasificación">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="category_id"/>
                            <field name="product_id"/>
                        </group>
                        <group string="Tarifa y vigencia">
                            <field name="price_per_km" string="Precio por km (€)"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Notas">
                        <field name="note" nolabel="1" placeholder="Observaciones sobre esta tarifa..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_proinca_mileage_rate_search" model="ir.ui.view">
        <field name="name">proinca.mileage.rate.search</field>
        <field name="model">proinca.mileage.rate</field>
        <field name="arch" type="xml">
            <search string="Buscar tarifas">
                <field name="category_id"/>
                <field name="product_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="active" string="Activas" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactivas" domain="[('active', '=', False)]"/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_category" string="Categoría" context="{'group_by': 'category_id'}"/>
                    <filter name="group_by_company" string="Empresa" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_proinca_mileage_rate" model="ir.actions.act_window">
        <field name="name">Tarifas de Kilometraje</field>
        <field name="res_model">proinca.mileage.rate</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"active_test": False}</field>
        <field name="search_view_id" ref="view_proinca_mileage_rate_search"/>
    </record>
</odoo>
