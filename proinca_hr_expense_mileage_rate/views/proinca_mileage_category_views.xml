<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_proinca_mileage_category_tree" model="ir.ui.view">
        <field name="name">proinca.mileage.category.tree</field>
        <field name="model">proinca.mileage.category</field>
        <field name="arch" type="xml">
            <list string="Kilometraje">
                <field name="name"/>
                <field name="rate_count" string="Tarifas"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_proinca_mileage_category_form" model="ir.ui.view">
        <field name="name">proinca.mileage.category.form</field>
        <field name="model">proinca.mileage.category</field>
        <field name="arch" type="xml">
            <form string="Kilometraje">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Categoría o convenio"/>
                        </h1>
                    </div>
                    <field name="description"
                           nolabel="1"
                           placeholder="Descripción interna opcional..."/>
                    <group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Tarifas">
                        <field name="rate_ids" nolabel="1">
                            <list string="Tarifas" editable="bottom">
                                <field name="company_id"/>
                                <field name="category_id" column_invisible="True"/>
                                <field name="product_tmpl_id"/>
                                <field name="price_per_km" string="€/km"/>
                                <field name="date_from" optional="hide"/>
                                <field name="date_to" optional="hide"/>
                                <field name="active" optional="hide"/>
                                <field name="note" optional="hide"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_proinca_mileage_category" model="ir.actions.act_window">
        <field name="name">Kilometraje</field>
        <field name="res_model">proinca.mileage.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"active_test": False}</field>
    </record>
</odoo>
