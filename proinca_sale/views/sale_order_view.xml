<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">Sale Slide Channel</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="is_formation" invisible="1"/>
                <field name="course_partner_formation_id" invisible="is_formation == False"/>
                <field name="manager_id" invisible="is_formation == False"/>
                <field name="tutor_id" domain="[('is_tutor', '=', True)]"
                       invisible="is_formation == False"/>
                <field name="url" invisible="is_formation == False"/>
                <field name="start_date" invisible="is_formation == False"/>
                <field name="end_date" invisible="is_formation == False"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="slide_channel_id" invisible="is_formation == False"/>
                <field name="modality" invisible="is_formation == False"/>
                <field name="price_hours" invisible="is_formation == False"/>
                <field name="questionnaire_number" invisible="is_formation == False"/>
                <field name="curso_n_group" invisible="is_formation == False"/>
                <field name="curso_learning_action" invisible="is_formation == False"/>
            </xpath>
            <xpath expr="//notebook/page[@name='order_lines']" position="after">
                <page string="Hitos" name="milestones" invisible="is_formation == False">
                    <field name="milestone_ids" widget="one2many">
                        <tree string="Hitos" editable="bottom">
                            <field name="date"/>
                        </tree>
                    </field>
                </page>
            </xpath>
            <field name="partner_invoice_id" position="attributes">
                <attribute name="invisible">is_formation == False</attribute>
            </field>
            <field name="partner_shipping_id" position="attributes">
                <attribute name="invisible">is_formation == False</attribute>
            </field>
            <field name="sale_order_template_id" position="attributes">
                <attribute name="invisible">is_formation == True</attribute>
            </field>

            <xpath expr="//header" position="inside">
                <field name="sale_order_template_no_modification" invisible="1"/>
            </xpath>

            <xpath expr="//button[@name='action_quotation_send']" position="replace">
                <button name="action_quotation_send" type="object" string="Enviar por correo electrónico" class="btn-primary"
                        invisible="sale_order_template_no_modification == True or state != 'draft'"/>
            </xpath>

            <xpath expr="//header/button[@name='action_cancel']" position="before">
                <button name="action_confirm" type="object" string="Aprobar"
                        invisible="sale_order_template_no_modification == False or state != 'draft'"/>
            </xpath>
            <xpath expr="//button[@name='action_confirm' and @id='action_confirm']" position="attributes">
                <attribute name="invisible">sale_order_template_no_modification == True or state != 'sent'</attribute>
            </xpath>
            <xpath expr="//button[@name='action_confirm' and not(@id)]" position="attributes">
                <attribute name="invisible">sale_order_template_no_modification == True or state != 'draft'</attribute>
            </xpath>

        </field>
    </record>
</odoo>
