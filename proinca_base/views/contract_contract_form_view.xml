<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_contract_form_view_inherit" model="ir.ui.view">
        <field name="name">contract.contract form view inherit</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='recurring_create_invoice']" position="replace">
                <button
                    name="recurring_create_invoice"
                    type="object"
                    invisible="create_invoice_visibility == False or generation_type != 'invoice'"
                    string="Crear facturas"
                />
            </xpath>
        </field>
    </record>
</odoo>
